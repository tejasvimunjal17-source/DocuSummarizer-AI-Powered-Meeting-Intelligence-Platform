# Copy this file to ".env" and fill in your real key. NEVER commit ".env".
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_api_key_here

# Optional overrides
# LLM_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.0

# Only needed if LLM_PROVIDER=openai
# OPENAI_API_KEY=your_api_key_here

# Chunking (Day 3) - measured in CHARACTERS, not tokens
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=200

# Summarization (Day 4) - all optional
# SUMMARY_MAX_RETRIES=2
# SUMMARY_RETRY_DELAY_SECONDS=1.0
# SUMMARY_TIMEOUT_SECONDS=60
# SUMMARY_REQUEST_DELAY_SECONDS=0
# SUMMARY_REDUCTION_BATCH_CHARS=12000
# SUMMARY_OUTPUT_LANGUAGE=English

